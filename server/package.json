{
    "name": "osudz-server",
    "version": "3.1.7",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --config ../vitest.server.config.ts",
        "db:check": "tsx src/scripts/check-db.ts",
        "migrate": "tsx src/scripts/migrate.ts",
        "migrate:status": "tsx src/scripts/migrate.ts --status",
        "dzpp:verify": "tsx src/scripts/verify-dzpp.ts"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "fflate": "^0.8.3",
        "multer": "^2.4.0",
        "pg": "^8.12.0",
        "qs": "6.16.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.0.0",
        "@types/pg": "^8.11.6",
        "tsx": "^4.15.7",
        "typescript": "^5.7.0",
        "vitest": "^5.0.1"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
