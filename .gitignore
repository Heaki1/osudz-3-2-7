# Dependencies
node_modules/

# Build output
dist/
build/
.vite/

# Environment / secrets
.env
.env.*
!.env.example

# Local overrides
*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS cruft
.DS_Store
Thumbs.db

# NOTE: .figma/ is intentionally NOT ignored — vite.config.ts imports
# ./.figma/make/site.json, so ignoring it would break the build.

# Local-only project notes
/docs/
/PROJECT STATE.MD

# Runtime uploads (player/replay files are never source-controlled)
server/uploads/
# Backup files
*.bak
*.backup
*.old
*.orig
*~

